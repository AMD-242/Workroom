{
  "compilerOptions": {
    "lib": ["ESNext", "Node"],
    "module": "ESNext",
    "moduleResolution": "Node",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "composite": true,
    "noEmit": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "composite": true,
    "types": ["vite/client"]
  },
  "include": ["vite.config.ts"]
}
